# Dashboard password
DASHBOARD_PASSWORD=password_goes_here

# Broker selection
BROKER=alpaca

# ── Alpaca Accounts ────────────────────────────────────────────
# Paper Account 1 — runs: Bull Put Spread, Bear Call Spread,
#                          Long Call Vertical
ALPACA_PAPER1_API_KEY=your_key_here
ALPACA_PAPER1_SECRET_KEY=your_secret_here

# Paper Account 2 — Standard Wheel Strategy
ALPACA_PAPER2_API_KEY=your_key_here
ALPACA_PAPER2_SECRET_KEY=your_secret_here

# Paper Account 3 — Iron Condor
ALPACA_PAPER3_API_KEY=your_key_here
ALPACA_PAPER3_SECRET_KEY=your_secret_here

# Paper Account 4 — Iron Butterfly
ALPACA_PAPER4_API_KEY=your_key_here
ALPACA_PAPER4_SECRET_KEY=your_secret_here

# Paper Account 5 — Calendar Spread
ALPACA_PAPER5_API_KEY=your_key_here
ALPACA_PAPER5_SECRET_KEY=your_secret_here

# Paper Account 6 — Turnover Wheel
ALPACA_PAPER6_API_KEY=your_key_here
ALPACA_PAPER6_SECRET_KEY=your_secret_here

ALPACA_PAPER=true

# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# Notifications
# ntfy push notifications — set NTFY_TOPIC to enable (leave blank to disable)
NTFY_TOPIC=topic_name_goes_here
# Override to use a self-hosted ntfy server (defaults to https://ntfy.sh)
NTFY_SERVER=https://ntfy.sh
# Set to "false" to demote fill notifications from critical to info (digest-only)
ALERT_FILLS=true

# ── FRED ───────────────────────────────────────────────────────
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# FINNHUB API key
FINNHUB_API_KEY=your_api_key_here

# ORATS API key
ORATS_API_KEY=your_api_key_here

# Resend
RESEND_API_KEY=your_api_key_here

# ── Schwab (future use) ────────────────────────────────────────
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=./schwab_token.json

# ── Deployment / runtime ───────────────────────────────────────
RENDER=false
DATA_DIR=data
DRY_RUN=false

PORT=8000
TZ=UTC

STRUCTURED_LOG_CAPTURE_ENABLED=true
OPTION_CHAIN_STRIKE_PRECLAMP_ENABLED =true
RESEARCH_RECOMMENDATIONS_ENABLED=true
STRATEGY_HEALTH_PAGE_ENABLED=true
TURNOVER_WHEEL_ENABLED=true
CROSS_ACCOUNT_ANTI_CROWDING_ENABLED=true
# Skip Claude call for IDLE CSP symbols where every -0.20 to -0.30 delta contract
# exceeds 10% of options_buying_power. Default false; flip true after verifying
# expected symbols produce STRUCTURALLY_UNTRADEABLE skip codes on a dry-run.
STRUCTURAL_UNTRADEABLE_FILTER_ENABLED=false

# Stale VIX tolerance: when the live VIX fetch returns None, fall back to the
# in-process cache if it is within the configured age window. Default false;
# flip true after verifying vix_stale appears correctly in macro context.
VIX_STALE_TOLERANCE_ENABLED=false
VIX_STALE_MAX_AGE_SECONDS_MARKET_HOURS=1800
VIX_STALE_MAX_AGE_SECONDS_OFF_HOURS=14400

CLOCK_DRIFT_HALT_ENABLED=true
FORCE_CLOSE_ENABLED=true
STARTUP_RECONCILE_ENABLED=true
DROP_COPY_RECONCILE_ENABLED=true
MACRO_EVENT_BLOCK_ENABLED=true
# ── Evaluation / scoring ───────────────────────────────────────
# Master switch for the monthly job orchestration
EVALUATION_AUTOMATION_ENABLED=false
# Enable the offline programmatic decision scorer.
# Set to "true" to allow --job=score_programmatic to run.
# Default false — turn on after rubric review and initial backfill.
EVALUATION_SCORER_ENABLED=false

# Enable the LLM-as-judge scorer (uses Claude Opus — incurs API costs).
# Set to "true" to allow --job=score_judge to run.
# Default false — turn on after reviewing prompts/judge/decision_rubric_v1.md.
EVALUATION_JUDGE_ENABLED=false

# Model used by the LLM judge.  Change to downgrade/upgrade without code changes.
JUDGE_MODEL=claude-opus-4-8

# Milliseconds to sleep between judge API calls (rate limiting).
JUDGE_RATE_LIMIT_MS=200

# Trading advisor model (ClaudeAdvisor). Change to downgrade/upgrade without
# code changes. Default claude-sonnet-5.
ADVISOR_MODEL=claude-sonnet-5

# Data source for /api/claude-costs. token_usage is the populated table;
# "decisions" is the legacy (empty) source, kept as a fallback.
CLAUDE_COSTS_SOURCE=token_usage

# ── Hermes report publishing ───────────────────────────────────
# When true, the publish_reports job commits the daily evaluation bundle to the
# private reports repo the Hermes self-improvement agent reads. Off by default —
# flip true in Render only after the bundle-enrichment change is deployed.
HERMES_PUBLISH_ENABLED=false
# Reports repo in "owner/name" form, e.g. davewevans/trade-pilot-reports.
GITHUB_REPORTS_REPO=
# A GitHub token (Bearer) with contents:write on the reports repo.
GITHUB_REPORTS_TOKEN=

# Enable monthly self-review: Opus analyzes flagged reasoning dimensions and
# proposes prompt patches. Off by default — flip true after reviewing
# prompts/self_review_v1.md and confirming cost tolerance.
SELF_REVIEW_ENABLED=false

# Maximum flags processed per self-review run (Opus call per flag).
SELF_REVIEW_MAX_FLAGS_PER_MONTH=5

# Minimum supporting decision IDs required for a patch to survive post-filter.
SELF_REVIEW_MIN_SUPPORTING_DECISIONS=3

# ── Research scoring multipliers ───────────────────────────────
# Boost entry scores using historical research data.
# RESEARCH_SCORE_MULTIPLIER_ENABLED: set to "false" to disable as a kill switch.
# RESEARCH_WINRATE_MULTIPLIER_ENABLED: leave false until the first weekly_research
#   sweep has populated symbol_strategy_stats and you've reviewed the multiplier
#   distribution via /api/research/winrate/symbol-stats. Flip to true after
#   verification.
RESEARCH_SCORE_MULTIPLIER_ENABLED=true
RESEARCH_WINRATE_MULTIPLIER_ENABLED=false
SHADOW_EXECUTION_ENABLED=true

# ── Scheduler / API guards ──────────────────────────────────────
# ALLOW_SCHEDULER: must be set to 1 on Render so the scheduler loop starts.
# Leave unset (commented out) locally — the scheduler should never run on
# a dev machine.
# ALLOW_SCHEDULER=1

# ALLOW_ORATS_LOCAL: only needed locally if you intentionally want to make
# real ORATS API calls (e.g. testing a new data fetch). Leave unset normally
# to avoid consuming quota while production is also running.
# ALLOW_ORATS_LOCAL=1

# ALLOW_LOCAL_NOTIFY: only needed locally if you want ntfy push notifications
# during local testing. Leave unset so only the Render instance sends alerts.
# ALLOW_LOCAL_NOTIFY=1
# ── Macro event block ──────────────────────────────────────────────────────────
# Blocks new entries the day of and the trading day before Tier 1 macro events
# (FOMC, CPI, NFP). Set to "false" to disable the block entirely.
# FOMC and CPI dates must be populated in data/macro_events.json; NFP dates
# are generated programmatically (first Friday of each month).
MACRO_EVENT_BLOCK_ENABLED=true

# Edge-triggered ntfy push when the macro block becomes active or clears.
# Default false — turn on after the first deploy lands and you've verified
# notifications/macro_block_state.json is being created on the first market_open.
MACRO_BLOCK_NOTIFY_ENABLED=false

# ── Healthchecks.io ────────────────────────────────────────────────────────────
# Global kill switch for Healthchecks.io pings. Default: true. Set false to silence all pings.
HEALTHCHECKS_ENABLED=true

# Per-job ping URLs. Absence disables monitoring for that job (no error, no log spam).
HC_PING_URL_PRE_MARKET=
HC_PING_URL_MARKET_OPEN=
HC_PING_URL_POSITION_CHECK=
HC_PING_URL_EXPIRY_GUARD=
HC_PING_URL_PRE_CLOSE=
HC_PING_URL_MARKET_CLOSE=
HC_PING_URL_POST_MARKET=
HC_PING_URL_PORTFOLIO_REFRESH=
HC_PING_URL_WEEKLY_REPORT=

# ── Sentry ────────────────────────────────────────────────────────────────────
# Sentry DSN for error monitoring. Leave blank to disable.
SENTRY_DSN=

HERMES_PUBLISH_ENABLED=false
GITHUB_REPORTS_REPO=davewevans/trade-pilot-reports
GITHUB_REPORTS_TOKEN=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
GITHUB_TRADEPILOT_REPO=davewevans/trade-pilot
GITHUB_TRADEPILOT_TOKEN=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
EVAL_NOTIFY_EMAIL=davewevans72@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=davewevans72@gmail.com
SMTP_PASS=mjdeotdkukhocnwc