# Dashboard password
DASHBOARD_PASSWORD=password_goes_here

# Broker selection
BROKER=alpaca

# ── Alpaca Accounts ────────────────────────────────────────────
# Default account — runs: Bull Put Spread, Bear Call Spread,
#                          Long Call Vertical
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# Wheel Strategy account
ALPACA_WHEEL_API_KEY=your_key_here
ALPACA_WHEEL_SECRET_KEY=your_secret_here

# Iron Condor account (created as "Iron Core" in Alpaca dashboard)
ALPACA_IRON_CONDOR_API_KEY=your_key_here
ALPACA_IRON_CONDOR_SECRET_KEY=your_secret_here

ALPACA_PAPER=true

# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── FRED ───────────────────────────────────────────────────────
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# FINNHUB API key
FINNHUB_API_KEY=your_api_key_here

# ORATS API key
ORATS_API_KEY=your_api_key_here

# ── Schwab (future use) ────────────────────────────────────────
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=./schwab_token.json

# ── Deployment / runtime ───────────────────────────────────────
RENDER=false
DATA_DIR=data
DRY_RUN=false

PORT=8000
TZ=UTC