# Dashboard password
DASHBOARD_PASSWORD=password_goes_here

# Broker selection
BROKER=alpaca

# ── Alpaca Accounts ────────────────────────────────────────────
# Paper Account 1 — runs: Bull Put Spread, Bear Call Spread,
#                          Long Call Vertical
ALPACA_PAPER1_API_KEY=your_key_here
ALPACA_PAPER1_SECRET_KEY=your_secret_here

# Paper Account 2 — Wheel Strategy
ALPACA_PAPER2_API_KEY=your_key_here
ALPACA_PAPER2_SECRET_KEY=your_secret_here

# Paper Account 3 — Iron Condor
ALPACA_PAPER3_API_KEY=your_key_here
ALPACA_PAPER3_SECRET_KEY=your_secret_here

# Paper Account — Conservative Wheel
ALPACA_CONSERVATIVE_WHEEL_API_KEY=your_key_here
ALPACA_CONSERVATIVE_WHEEL_SECRET_KEY=your_secret_here

# Paper Account 4 — Short Strangle (inactive until tested)
ALPACA_PAPER4_API_KEY=your_key_here
ALPACA_PAPER4_SECRET_KEY=your_secret_here

# Paper Account 5 — Calendar Spread (inactive until tested)
ALPACA_PAPER5_API_KEY=your_key_here
ALPACA_PAPER5_SECRET_KEY=your_secret_here

# Paper Account 6 — Reserved
ALPACA_PAPER6_API_KEY=your_key_here
ALPACA_PAPER6_SECRET_KEY=your_secret_here

ALPACA_PAPER=true

# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# Notifications
# ntfy push notifications — set NTFY_TOPIC to enable (leave blank to disable)
NTFY_TOPIC=topic_name_goes_here
# Override to use a self-hosted ntfy server (defaults to https://ntfy.sh)
NTFY_SERVER=https://ntfy.sh
# Set to "false" to demote fill notifications from critical to info (digest-only)
ALERT_FILLS=true

# ── FRED ───────────────────────────────────────────────────────
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# FINNHUB API key
FINNHUB_API_KEY=your_api_key_here

# ORATS API key
ORATS_API_KEY=your_api_key_here

# Resend
RESEND_API_KEY=your_api_key_here

# ── Schwab (future use) ────────────────────────────────────────
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=./schwab_token.json

# ── Deployment / runtime ───────────────────────────────────────
RENDER=false
DATA_DIR=data
DRY_RUN=false

PORT=8000
TZ=UTC

# ── Local dev guards (do NOT set these on Render) ───────────────
# Uncomment to allow the scheduler loop to run locally (default: blocked).
# On Render, set ALLOW_SCHEDULER=1 as an environment variable.
# ALLOW_SCHEDULER=1

# Uncomment to allow ORATS API calls from a local machine (default: blocked
# when RENDER=false, to prevent double-spending quota alongside production).
# ALLOW_ORATS_LOCAL=1

# Uncomment to allow ntfy push notifications from a local machine (default:
# suppressed when RENDER=false so only production sends phone alerts).
# ALLOW_LOCAL_NOTIFY=1